<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>controls</name>
  <width>600</width>
  <height>400</height>
  <widget type="slide_button" version="2.0.0">
    <name>sb_nolabel</name>
    <pv_name>loc://sb1&lt;VLong&gt;(0)</pv_name>
    <label/>
    <x>10</x><y>10</y><width>20</width><height>20</height>
    <off_color><color red="229" green="235" blue="255"></color></off_color>
    <on_color><color red="37" green="99" blue="235"></color></on_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>sb1v</name><pv_name>loc://sb1</pv_name><x>300</x><y>10</y>
  </widget>
  <widget type="slide_button" version="2.0.0">
    <name>sb_label</name>
    <pv_name>loc://sb2&lt;VLong&gt;(0)</pv_name>
    <label>Enable thing</label>
    <x>10</x><y>40</y><width>200</width><height>30</height>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>sb2v</name><pv_name>loc://sb2</pv_name><x>300</x><y>40</y>
  </widget>
  <widget type="slide_button" version="2.0.0">
    <name>sb_bit2</name>
    <pv_name>loc://sb3&lt;VLong&gt;(1)</pv_name>
    <bit>2</bit>
    <x>10</x><y>80</y><width>200</width><height>30</height>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>sb3v</name><pv_name>loc://sb3</pv_name><x>300</x><y>80</y>
  </widget>
  <widget type="checkbox" version="2.0.0">
    <name>cb</name>
    <pv_name>loc://cb1&lt;VLong&gt;(0)</pv_name>
    <label>Check me</label>
    <x>10</x><y>120</y><width>200</width><height>20</height>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>cb1v</name><pv_name>loc://cb1</pv_name><x>300</x><y>120</y>
  </widget>
  <widget type="checkbox" version="2.0.0">
    <name>cb_bit</name>
    <pv_name>loc://cb2&lt;VLong&gt;(1)</pv_name>
    <label>Bit 3</label>
    <bit>3</bit>
    <x>10</x><y>150</y><width>200</width><height>20</height>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>cb2v</name><pv_name>loc://cb2</pv_name><x>300</x><y>150</y>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>bb</name>
    <pv_name>loc://bb1&lt;VLong&gt;(0)</pv_name>
    <x>10</x><y>180</y><width>100</width><height>30</height>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>bb1v</name><pv_name>loc://bb1</pv_name><x>300</x><y>180</y>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>bb_bit</name>
    <pv_name>loc://bb2&lt;VLong&gt;(1)</pv_name>
    <bit>1</bit>
    <x>10</x><y>220</y><width>100</width><height>30</height>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>bb2v</name><pv_name>loc://bb2</pv_name><x>300</x><y>220</y>
  </widget>
  <widget type="combo" version="2.0.0">
    <name>combo</name>
    <pv_name>loc://e1&lt;VEnum&gt;(0,"Single","Multiple","Continuous")</pv_name>
    <x>10</x><y>260</y><width>120</width><height>25</height>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>e1v</name><pv_name>loc://e1</pv_name><x>300</x><y>260</y>
  </widget>
  <widget type="combo" version="2.0.0">
    <name>combo_nopv</name>
    <pv_name>loc://e2&lt;VString&gt;("a")</pv_name>
    <items_from_pv>false</items_from_pv>
    <items><item>a</item><item>b</item></items>
    <x>140</x><y>260</y><width>120</width><height>25</height>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>e2v</name><pv_name>loc://e2</pv_name><x>300</x><y>290</y>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>multi</name>
    <actions>
      <action type="write_pv"><pv_name>loc://w1&lt;VLong&gt;(0)</pv_name><value>5</value><description>Five</description></action>
      <action type="write_pv"><pv_name>loc://w1</pv_name><value>7</value><description>Seven</description></action>
    </actions>
    <pv_name>loc://w1</pv_name>
    <text>Multi</text>
    <x>10</x><y>320</y><width>100</width><height>30</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>single</name>
    <actions>
      <action type="write_pv"><pv_name>$(pv_name)</pv_name><value>3</value><description>$(name)</description></action>
    </actions>
    <pv_name>loc://w1</pv_name>
    <text>Three</text>
    <x>120</x><y>320</y><width>100</width><height>30</height>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>w1v</name><pv_name>loc://w1</pv_name><x>300</x><y>320</y>
  </widget>
</display>
